DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crypto5"

# Optional password for the whole app (recommended if you put it online). Leave empty for no login.
APP_PASSWORD=""
AUTH_SECRET="change-me-to-a-long-random-string-of-32+chars"

# Protects the automatic daily scan endpoint /api/cron/scan
CRON_SECRET="change-me"

# LIVE = real APIs. SAMPLE = built-in fictional sample data for testing only (clearly labelled in the app).
DATA_MODE="LIVE"

# --- Market data (free tiers work) ---
# CoinGecko: free "Demo" key from coingecko.com/en/api. Set COINGECKO_PLAN="pro" if you have a paid key.
COINGECKO_API_KEY=""
COINGECKO_PLAN="demo"
# CoinMarketCap (optional, free basic key) – used to cross-check prices and market caps
CMC_API_KEY=""
# GitHub token (optional, free) – raises the GitHub limit from 60 to 5,000 requests/hour
GITHUB_TOKEN=""
# CryptoPanic (optional, free key) – news headlines
CRYPTOPANIC_API_KEY=""
