{%- comment -%}
  NovaCrest premium hero. Two layouts:
  - "full": full-width lifestyle image with the text on a soft dark overlay (Prestige style)
  - "split": text left, image right
  Separate mobile image and focal point supported. Original setting IDs are kept.
{%- endcomment -%}
{%- liquid
  assign img = section.settings.image
  assign mimg = section.settings.mobile_image | default: img
  assign layout = section.settings.layout | default: 'full'
-%}
<section class="nova-hero nova-hero--{{ layout }}" style="--nova-hero-h: {{ section.settings.height }}vh; --nova-hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
  <div class="nova-hero__inner">
    <div class="nova-hero__image-wrap">
      {%- if img != blank -%}
        <picture>
          <source media="(max-width: 749px)" srcset="{{ mimg | image_url: width: 750 }} 750w, {{ mimg | image_url: width: 1100 }} 1100w" sizes="100vw">
          <img
            src="{{ img | image_url: width: 1600 }}"
            srcset="{{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1400 }} 1400w, {{ img | image_url: width: 1920 }} 1920w, {{ img | image_url: width: 2400 }} 2400w"
            sizes="{% if layout == 'split' %}(max-width: 989px) 100vw, 55vw{% else %}100vw{% endif %}"
            alt="{{ img.alt | default: section.settings.heading | escape }}"
            loading="eager" fetchpriority="high" decoding="async"
            width="{{ img.width }}" height="{{ img.height }}"
            style="object-position: {{ img.presentation.focal_point | default: 'center' }};"
            class="nova-hero__img">
        </picture>
      {%- else -%}
        <div class="nova-hero__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {%- endif -%}
    </div>

    <div class="nova-hero__content">
      {%- if section.settings.caption != blank -%}<span class="nova-hero__eyebrow">{{ section.settings.caption | escape }}</span>{%- endif -%}
      <h1 class="nova-hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.subtext != blank -%}<p class="nova-hero__sub">{{ section.settings.subtext | escape }}</p>{%- endif -%}
      <div class="nova-hero__actions">
        {%- if section.settings.btn1_label != blank -%}
          <a href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}" class="nova-hero__btn nova-hero__btn--primary">{{ section.settings.btn1_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.btn2_label != blank -%}
          <a href="{{ section.settings.btn2_link | default: routes.collections_url }}" class="nova-hero__btn nova-hero__btn--secondary">{{ section.settings.btn2_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .nova-hero { position: relative; overflow: hidden; background: #f7f7f7 !important; }
  .nova-hero__inner { position: relative; max-width: 100%; }
  .nova-hero__image-wrap { position: relative; overflow: hidden; background: #f7f7f7; }
  .nova-hero__img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .nova-hero__placeholder { width: 100%; height: 100%; min-height: 50vh; background: #e8e8e8 !important; }
  .nova-hero__placeholder svg { width: 100%; height: 100%; }
  .nova-hero__content { display: flex; flex-direction: column; gap: 2rem; }
  .nova-hero__eyebrow { font-family: var(--font-body-family); font-size: 1.1rem; font-weight: 500; letter-spacing: .3em; text-transform: uppercase; border: 0 !important; padding: 0 !important; }
  .nova-hero__heading { margin: 0; font-size: clamp(3.4rem, 5.2vw, 7.2rem); font-weight: 400; line-height: 1.04; letter-spacing: -.02em; max-width: 12em; }
  .nova-hero__sub { margin: 0; font-size: 1.6rem; line-height: 1.7; max-width: 46rem; }
  .nova-hero__actions { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: .8rem; }
  .nova-hero__btn { display: inline-flex; align-items: center; justify-content: center; min-height: 5.2rem; padding: 0 3.2rem; font-family: var(--font-body-family); font-size: 1.2rem; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; text-decoration: none; border: 1px solid; transition: background-color .3s ease, color .3s ease, border-color .3s ease; }

  /* Full-width layout */
  .nova-hero--full .nova-hero__image-wrap { height: var(--nova-hero-h, 86vh); min-height: 52rem; }
  .nova-hero--full .nova-hero__image-wrap::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,var(--nova-hero-overlay)) 0%, rgba(0,0,0,calc(var(--nova-hero-overlay) * .4)) 60%, rgba(0,0,0,0) 100%); pointer-events: none; }
  .nova-hero--full .nova-hero__content { position: absolute; inset: 0; justify-content: center; align-items: flex-start; padding: 0 max(5rem, calc((100vw - var(--page-width, 130rem)) / 2 + 5rem)); color: #ffffff; }
  .nova-hero--full .nova-hero__heading, .nova-hero--full .nova-hero__eyebrow { color: #ffffff !important; }
  .nova-hero--full .nova-hero__sub { color: rgba(255,255,255,.88) !important; }
  .nova-hero--full .nova-hero__btn--primary { background: #ffffff; color: #111111; border-color: #ffffff; }
  .nova-hero--full .nova-hero__btn--primary:hover { background: transparent; color: #ffffff; }
  .nova-hero--full .nova-hero__btn--secondary { background: transparent; color: #ffffff; border-color: rgba(255,255,255,.8); }
  .nova-hero--full .nova-hero__btn--secondary:hover { background: #ffffff; color: #111111; border-color: #ffffff; }

  /* Split layout */
  .nova-hero--split { background: #ffffff !important; }
  .nova-hero--split .nova-hero__inner { display: grid; grid-template-columns: 45fr 55fr; min-height: var(--nova-hero-h, 80vh); align-items: stretch; }
  .nova-hero--split .nova-hero__image-wrap { order: 2; min-height: 60vh; }
  .nova-hero--split .nova-hero__content { order: 1; justify-content: center; padding: 6rem 5rem 6rem max(5rem, calc((100vw - var(--page-width, 130rem)) / 2 + 5rem)); color: #111111; }
  .nova-hero--split .nova-hero__eyebrow { color: #777777 !important; }
  .nova-hero--split .nova-hero__sub { color: #555555 !important; }
  .nova-hero--split .nova-hero__btn--primary { background: #111111; color: #ffffff; border-color: #111111; }
  .nova-hero--split .nova-hero__btn--primary:hover { background: #ffffff; color: #111111; }
  .nova-hero--split .nova-hero__btn--secondary { background: transparent; color: #111111; border-color: #111111; }
  .nova-hero--split .nova-hero__btn--secondary:hover { background: #111111; color: #ffffff; }

  /* Subtle entrance */
  @media (prefers-reduced-motion: no-preference) {
    .nova-hero__img { animation: nova-hero-zoom 1.6s cubic-bezier(.2,.6,.2,1) both; }
    .nova-hero__content > * { animation: nova-hero-rise .9s cubic-bezier(.2,.6,.2,1) both; }
    .nova-hero__content > *:nth-child(2) { animation-delay: .12s; }
    .nova-hero__content > *:nth-child(3) { animation-delay: .24s; }
    .nova-hero__content > *:nth-child(4) { animation-delay: .36s; }
  }
  @keyframes nova-hero-zoom { from { transform: scale(1.04); opacity: .6; } to { transform: scale(1); opacity: 1; } }
  @keyframes nova-hero-rise { from { transform: translateY(1.6rem); opacity: 0; } to { transform: none; opacity: 1; } }

  @media screen and (max-width: 989px) {
    .nova-hero--split .nova-hero__inner { grid-template-columns: 1fr; min-height: 0; }
    .nova-hero--split .nova-hero__image-wrap { order: 0; min-height: 0; aspect-ratio: 4 / 3; }
    .nova-hero--split .nova-hero__content { padding: 4rem 2rem 5rem; align-items: center; text-align: center; }
    .nova-hero--split .nova-hero__actions { justify-content: center; }
  }
  @media screen and (max-width: 749px) {
    .nova-hero--full .nova-hero__image-wrap { height: auto; min-height: 0; aspect-ratio: 4 / 5; max-height: 82vh; }
    .nova-hero--full .nova-hero__image-wrap::after { background: linear-gradient(0deg, rgba(0,0,0,calc(var(--nova-hero-overlay) * 1.2)) 0%, rgba(0,0,0,calc(var(--nova-hero-overlay) * .5)) 55%, rgba(0,0,0,0) 100%); }
    .nova-hero--full .nova-hero__content { justify-content: flex-end; padding: 0 2rem 4rem; gap: 1.4rem; }
    .nova-hero__heading { font-size: clamp(3.2rem, 9vw, 4.4rem); }
    .nova-hero__sub { font-size: 1.45rem; }
    .nova-hero__actions { width: 100%; flex-direction: column; }
    .nova-hero__btn { width: 100%; min-height: 4.8rem; padding: 0 1.6rem; }
  }
</style>

{% schema %}
{
  "name": "Premium hero",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "options": [ { "value": "full", "label": "Full-width image" }, { "value": "split", "label": "Text left, image right" } ], "default": "full" },
    { "type": "text",         "id": "caption",    "label": "Small eyebrow text",  "default": "NovaCrest Kitchen" },
    { "type": "text",         "id": "heading",    "label": "Main heading",        "default": "Elevate Your Everyday Living." },
    { "type": "text",         "id": "subtext",    "label": "Subtext",             "default": "Discover thoughtfully designed kitchen essentials that bring quality, simplicity and elegance to your everyday routine." },
    { "type": "image_picker", "id": "image",      "label": "Image", "info": "Use a wide lifestyle photo, at least 2400px wide. Set the focal point in the image picker." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)", "info": "Portrait photo (4:5) for phones. Falls back to the main image." },
    { "type": "range", "id": "height", "label": "Desktop height", "min": 50, "max": 100, "step": 2, "unit": "vh", "default": 86 },
    { "type": "range", "id": "overlay", "label": "Image darkening (full-width layout)", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 40 },
    { "type": "text",         "id": "btn1_label", "label": "Primary button",      "default": "Shop collection" },
    { "type": "url",          "id": "btn1_link",  "label": "Primary button link" },
    { "type": "text",         "id": "btn2_label", "label": "Secondary button",    "default": "Explore our products" },
    { "type": "url",          "id": "btn2_link",  "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Premium hero" }]
}
{% endschema %}
