{%- comment -%}
  NovaCrest top announcement bar: black bar, white text, slow seamless right-to-left marquee.
  Everything is editable in the theme editor. Type [CODE] in a message to insert the discount code setting.
  Two identical lists are animated by -50% so the loop never jumps; height is fixed so there is no layout shift.
{%- endcomment -%}
{%- liquid
  assign code = section.settings.code | strip | upcase
  assign repeat = section.settings.repeat | default: 3
-%}
{%- if section.blocks.size > 0 -%}
  {%- capture items -%}
    {%- for block in section.blocks -%}
      {%- assign msg = block.settings.text | escape | replace: '[CODE]', code -%}
      <li class="nova-ab-item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ msg }}</a>{%- else -%}{{ msg }}{%- endif -%}
      </li>
    {%- endfor -%}
  {%- endcapture -%}
  <div class="nova-ab-bar" role="region" aria-label="{{ 'sections.header.announcement' | t | default: 'Announcement' }}">
    {%- comment -%} Screen readers get the messages once, without the animation copies. {%- endcomment -%}
    <p class="visually-hidden">
      {%- for block in section.blocks -%}{{ block.settings.text | escape | replace: '[CODE]', code }}{% unless forloop.last %}. {% endunless %}{%- endfor -%}
    </p>
    <div class="nova-ab-track" style="--nova-ab-speed: {{ section.settings.speed }}s;" aria-hidden="true">
      <ul class="nova-ab-list" role="list">{% for i in (1..repeat) %}{{ items }}{% endfor %}</ul>
      <ul class="nova-ab-list" role="list">{% for i in (1..repeat) %}{{ items }}{% endfor %}</ul>
    </div>
  </div>
{%- endif -%}

<style>
  .nova-ab-bar { background: #111111; color: #ffffff; overflow: hidden; height: 3.8rem; display: flex; align-items: center; position: relative; z-index: 4; border-bottom: 1px solid rgba(255,255,255,.12); contain: layout paint; }
  .nova-ab-track { display: flex; width: max-content; will-change: transform; animation: nova-ab-scroll var(--nova-ab-speed, 40s) linear infinite; }
  .nova-ab-bar:hover .nova-ab-track, .nova-ab-bar:focus-within .nova-ab-track { animation-play-state: paused; }
  .nova-ab-list { display: flex; flex-shrink: 0; margin: 0; padding: 0; list-style: none; }
  .nova-ab-item { display: flex; align-items: center; white-space: nowrap; font-family: var(--font-body-family); font-size: 1.1rem; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; color: #ffffff; }
  .nova-ab-item::after { content: ""; display: inline-block; width: .4rem; height: .4rem; margin: 0 4rem; border-radius: 50%; background: rgba(255,255,255,.45); }
  .nova-ab-item a { color: inherit; text-decoration: none; }
  @keyframes nova-ab-scroll { from { transform: translate3d(0,0,0); } to { transform: translate3d(-50%,0,0); } }
  @media (prefers-reduced-motion: reduce) {
    .nova-ab-track { animation: none; width: 100%; justify-content: center; }
    .nova-ab-list + .nova-ab-list, .nova-ab-list .nova-ab-item:not(:first-child) { display: none; }
    .nova-ab-item::after { display: none; }
  }
  @media screen and (max-width: 749px) {
    .nova-ab-bar { height: 3.4rem; }
    .nova-ab-item { font-size: 1rem; letter-spacing: .14em; }
    .nova-ab-item::after { margin: 0 2.4rem; }
  }
</style>

{% schema %}
{
  "name": "Announcement ticker",
  "settings": [
    { "type": "text", "id": "code", "label": "Discount code", "info": "Type [CODE] in a message to show this code. The code must exist in Shopify Discounts.", "default": "WELCOME10" },
    { "type": "range", "id": "speed", "label": "Seconds per loop (higher is slower)", "min": 20, "max": 120, "step": 5, "default": 45 },
    { "type": "range", "id": "repeat", "label": "Times each message repeats per loop", "info": "Increase if the bar looks empty on wide screens.", "min": 1, "max": 6, "step": 1, "default": 3 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon / symbol (not shown in the new design)" },
        { "type": "text", "id": "text", "label": "Message", "default": "LIMITED-TIME OFFER | GET 10% OFF YOUR ORDER | USE CODE [CODE] AT CHECKOUT" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [ { "name": "Announcement ticker", "blocks": [ { "type": "message" } ] } ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
